{
  "name": "@banklink/sdk",
  "version": "0.3.0",
  "description": "Official Banklink SDK for TypeScript and Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index*",
    "dist/client*",
    "dist/errors*",
    "dist/types*",
    "dist/v2*",
    "dist/local*",
    "dist/webhooks*",
    "dist/resources"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && node scripts/check-release.mjs node_modules/@banklink/crypto"
  },
  "keywords": [
    "banklink",
    "open-banking",
    "south-africa",
    "fintech"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurvex-labs/banklink-node.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^20.19.43",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "zod": "4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    }
  },
  "dependencies": {
    "@banklink/crypto": "file:vendor/banklink-crypto-0.2.1.tgz"
  },
  "bundledDependencies": [
    "@banklink/crypto"
  ]
}
